# ============================================================
# CV OPTIMIZER — single production env file, shared by both apps.
# Used by docker-compose.prod.yml for postgres, api, and web alike (each
# reads only its own prefixed subset — see .env.example for the convention).
# Copy to .env.prod.
# ============================================================

# ============================================================
# DATABASE (docker-compose.prod.yml postgres init vars)
# ============================================================
POSTGRES_USER=cvoptimizer
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cv_optimizer

# ============================================================
# BACKEND (apps/api) — hostname is "postgres" (docker service name)
# ============================================================
API_DATABASE_URL="postgresql://cvoptimizer:CHANGE_ME_STRONG_PASSWORD@postgres:5432/cv_optimizer"

# Session & Encryption — generate: openssl rand -hex 32
API_ENCRYPTION_KEY=GENERATE_64_HEX_CHARS
API_SESSION_SECRET=GENERATE_64_HEX_CHARS
API_SESSION_TTL_HOURS=2

# Google OAuth
API_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
API_GOOGLE_CLIENT_SECRET=GOCSPX-...
API_GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/auth/google/callback

# AI fallback (optional — users bring own credentials via session)
API_AI_PROVIDER=claude
API_ANTHROPIC_API_KEY=sk-ant-...
API_OPENAI_API_KEY=sk-...

# Server — PORT is intentionally unprefixed (hosting platforms inject it directly)
PORT=3001
NODE_ENV=production
API_FRONTEND_URL=https://YOUR_DOMAIN
API_CORS_ORIGIN=https://YOUR_DOMAIN
API_JWT_SECRET=GENERATE_64_HEX_CHARS

# File uploads
API_UPLOAD_DIR=uploads
API_MAX_FILE_SIZE_MB=10

# ============================================================
# FRONTEND (apps/web)
# ============================================================
# Must be the public domain — no trailing slash
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN
